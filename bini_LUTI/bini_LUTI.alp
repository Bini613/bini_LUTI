			<Presentation>
				<Rectangle>
					<Id>1793806667838</Id>
					<Name><![CDATA[rectangle]]></Name>
					<X>-65</X><Y>-60</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>true</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>false</ShowLabel>
					<DrawMode>SHAPE_DRAW_2D</DrawMode>
					<XCode><![CDATA[-main.parSpacing/2]]></XCode>
					<YCode><![CDATA[-main.parSpacing/2]]></YCode>
					<VisibleCode><![CDATA[main.varShowGraphics]]></VisibleCode>
					<OnClickCode><![CDATA[// Prints this node's rent compared with the average over all nodes and over occupied nodes (nodes with at least one resident)
double sumAll = 0, sumOcc = 0;
int nOcc = 0;
for (GridPoint g : main.gridPoints) {
    sumAll += g.varRent;
    if (!g.colResidents.isEmpty()) {
        sumOcc += g.varRent;
        nOcc++;
    }
}
double avgAll = sumAll / main.gridPoints.size();
double avgOcc = nOcc > 0 ? sumOcc / nOcc : 0;
traceln("Node (" + parXIndex + "," + parYIndex + ") rent " + roundToDecimal(varRent, 0)
        + " | x" + roundToDecimal(varRent / avgAll, 2) + " of all-node average (" + roundToDecimal(avgAll, 0) + ")"
        + " | x" + roundToDecimal(nOcc > 0 ? varRent / avgOcc : 0, 2) + " of occupied-node average (" + roundToDecimal(avgOcc, 0) + ")");]]></OnClickCode>
					<EmbeddedIcon>false</EmbeddedIcon>
					<Z>0</Z>
					<ZHeight>0</ZHeight>
					<LineWidth>0</LineWidth>
					<LineColor/>
					<LineMaterial>null</LineMaterial>
					<LineStyle>SOLID</LineStyle>
					<Width>130</Width>
					<Height>120</Height>
					<WidthCode><![CDATA[main.parSpacing]]></WidthCode>
					<HeightCode><![CDATA[main.parSpacing]]></HeightCode>
					<Rotation>0.0</Rotation>
					<FillColor>-1</FillColor>
					<FillColorCode><![CDATA[lerpColor(min(1, max(0, (varRent - main.parRentMin) / (main.parRentColourScaleMultiple * main.parRentRef - main.parRentMin))), white, red)]]></FillColorCode>
					<FillMaterial>null</FillMaterial>
				</Rectangle>
